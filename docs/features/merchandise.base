filters:
  or:
    - file.hasTag("feature/category")
    - file.hasTag("feature/product")
    - file.hasTag("feature/attributes")
    - file.hasTag("module/merchandise")
    - file.inFolder("docs/features/category")
    - file.inFolder("docs/features/product")
    - file.inFolder("docs/features/attributes")

formulas:
  days_since_updated: '(now() - file.mtime).days.round(0)'
  status_badge: 'if(status == "completed", "✅ Completed", if(status == "in-progress", "🚧 In Progress", if(status == "planned", "📋 Planned", "📝 Draft")))'
  summary_preview: 'if(description, description, "No description provided")'

properties:
  status:
    displayName: "Status"
  formula.status_badge:
    displayName: "State"
  formula.days_since_updated:
    displayName: "Updated (Days Ago)"
  module:
    displayName: "Module"
  priority:
    displayName: "Priority"

views:
  - type: table
    name: "Merchandise Features Overview"
    order:
      - file.name
      - formula.status_badge
      - module
      - priority
      - formula.days_since_updated
      - file.mtime
    groupBy:
      property: module
      direction: ASC

  - type: cards
    name: "Feature Gallery"
    order:
      - file.name
      - formula.status_badge
      - formula.summary_preview
    filters:
      not:
        - 'status == "deprecated"'

  - type: list
    name: "Recent Updates"
    limit: 20
    order:
      - file.name
      - formula.status_badge
      - file.mtime
